{
  "name": "weatherline",
  "author": "Alec Hudson",
  "version": "1.2.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Weatherline",
    "uuid": "32195aa6-6aa4-44e6-ac62-74ee47cc4974",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery", "gabbro"],
    "watchapp": {
      "watchface": true
    },
    "capabilities": ["configurable", "location", "health"],
    "messageKeys": ["PAYLOAD", "REQUEST", "TOPLINE"],
    "usesPermissions": [
      "Location",
      {
        "name": "Internet",
        "parameters": {
          "domains": ["api.open-meteo.com", "geocoding-api.open-meteo.com", "api.bigdatacloud.net"]
        }
      }
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_TIME_72",
          "file": "fonts/BarlowCondensed-SemiBold.ttf",
          "characterRegex": "[0-9:]",
          "targetPlatforms": ["emery"]
        },
        {
          "type": "font",
          "name": "FONT_TIME_48",
          "file": "fonts/BarlowCondensed-SemiBold.ttf",
          "characterRegex": "[0-9:]",
          "targetPlatforms": ["gabbro"]
        }
      ]
    }
  }
}
