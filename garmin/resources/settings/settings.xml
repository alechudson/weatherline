<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <setting propertyKey="@Properties.span" title="@Strings.SpanTitle">
        <settingConfig type="list">
            <listEntry value="12">@Strings.Span12</listEntry>
            <listEntry value="24">@Strings.Span24</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.units" title="@Strings.UnitsTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.UnitsWatch</listEntry>
            <listEntry value="1">@Strings.UnitsF</listEntry>
            <listEntry value="2">@Strings.UnitsC</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.light" title="@Strings.LightTitle">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.btAlert" title="@Strings.BtTitle">
        <settingConfig type="boolean"/>
    </setting>
</settings>
